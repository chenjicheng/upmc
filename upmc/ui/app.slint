import { VerticalBox, HorizontalBox, ScrollView, AboutSlint, TextEdit } from "std-widgets.slint";
component Action inherits Rectangle {
 in property <bool> enabled: true;
 in property <bool> dim-disabled: true;
 accessible-enabled: root.enabled;
 opacity: root.enabled || !root.dim-disabled ? 1 : 0.45;
 in property <string> label;
 in property <string> accessible-name: label;
 in property <bool> active: false;
 in property <bool> primary: false;
 in property <color> text-color: #59625b;
 in property <bool> left-aligned: false;
 callback clicked;
 height: 34px; border-radius: 6px;
 forward-focus: keys;
 accessible-role: button; accessible-label: root.accessible-name;
 accessible-action-default => { if root.enabled { root.clicked(); } }
 border-width: keys.has-focus ? 2px : 0px; border-color: #738079;
 background: primary ? (touch.has-hover ? #3e4741 : #28332c) : (active || touch.has-hover ? #e7ebe7 : transparent);
 Text { accessible-role: none; text: root.label; color: root.primary ? #ffffff : root.text-color; font-size: 13px; horizontal-alignment: root.left-aligned ? left : center; vertical-alignment: center; }
 keys := FocusScope { enabled: root.enabled; width: 0px; key-pressed(event) => { if (event.text == " " || event.text == "\n") { root.clicked(); return accept; } return reject; } }
 touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
component ToggleSwitch inherits Rectangle {
 in property <bool> enabled: true;
 accessible-enabled: root.enabled;
 opacity: 1;
 in property <bool> checked;
 in property <string> accessible-name;
 callback toggled;
 width: 40px; height: 32px;
 accessible-role: switch;
 accessible-label: root.accessible-name;
 accessible-checkable: true;
 accessible-checked: root.checked;
 accessible-action-default => { if root.enabled { root.toggled(); } }
 forward-focus: keys;
 Rectangle {
  y: 6px; width: 40px; height: 20px; border-radius: 10px;
  background: root.checked ? #619775 : #c4ccc4;
  animate background { duration: 160ms; }
  Rectangle {
   x: root.checked ? 23px : 3px; y: 3px; width: 14px; height: 14px;
   border-radius: 7px; background: white;
   animate x { duration: 160ms; easing: ease-out; }
  }
 }
 if keys.has-focus : Rectangle { x: -3px; y: 3px; width: 46px; height: 26px; border-radius: 13px; border-width: 1px; border-color: #657b69; background: transparent; }
 keys := FocusScope { enabled: root.enabled; width: 0px; key-pressed(event) => { if (event.text == " " || event.text == "\n") {root.toggled(); return accept;} return reject; } }
 touch := TouchArea { enabled: root.enabled; clicked => {root.toggled();} }
}
component CaptionButton inherits Rectangle {
 in property <string> glyph;
 in property <string> name;
 in property <length> icon-size: 10px;
 in property <bool> close-button: false;
 callback clicked;
 width: 46px; height: 32px;
 accessible-role: button; accessible-label: root.name;
 accessible-action-default => { root.clicked(); }
 forward-focus: keys;
 background: touch.pressed ? (root.close-button ? #c50f1f : #d6d6d6) : touch.has-hover ? (root.close-button ? #c42b1c : #e6e6e6) : transparent;
 Text {
  text: root.glyph; font-family: "Segoe MDL2 Assets"; font-size: root.icon-size;
  color: root.close-button && (touch.has-hover || touch.pressed) ? white : #202020;
  horizontal-alignment: center; vertical-alignment: center;
  accessible-role: none;
 }
 if keys.has-focus : Rectangle { x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; border-width: 1px; border-color: #737373; background: transparent; }
 keys := FocusScope { width: 0px; key-pressed(event) => { if (event.text == " " || event.text == "\n") { root.clicked(); return accept; } return reject; } }
 touch := TouchArea { clicked => { root.clicked(); } }
}
component NavItem inherits Rectangle {
 in property <string> label;
 in property <bool> selected;
 callback clicked;
 width: 64px; height: 44px;
 accessible-role: button; accessible-label: root.label;
 accessible-checkable: true; accessible-checked: root.selected;
 accessible-action-default => { root.clicked(); }
 forward-focus: keys;
 background: touch.has-hover ? #edf0eb : transparent;
 Text { text: root.label; color: root.selected ? #28332c : #7c847c; font-size: 14px; font-weight: root.selected ? 600 : 400; vertical-alignment: center; horizontal-alignment: center; accessible-role: none; }
 if root.selected : Rectangle { x: 18px; y: parent.height - 3px; width: 28px; height: 2px; border-radius: 1px; background: #486852; }
 if keys.has-focus : Rectangle { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px; border-width: 1px; border-color: #738079; border-radius: 4px; background: transparent; }
 keys := FocusScope { width: 0px; key-pressed(event) => { if (event.text == " " || event.text == "\n") {root.clicked(); return accept;} return reject; } }
 touch := TouchArea { clicked => {root.clicked();} }
}
component CreditItem inherits Rectangle {
 in property <string> name;
 in property <string> detail;
 height: 52px;
 VerticalBox { padding: 0px; spacing: 4px;
  Text { text: root.name; color: #435044; font-size: 14px; height: 20px; }
  Text { text: root.detail; color: #657066; font-size: 12px; height: 20px; }
  Rectangle { vertical-stretch: 1; }
 }
}
export component App inherits Window {
 in property <string> window-title: "UPMC";
 title: root.window-title; no-frame: true; resize-border-width: 5px;
 preferred-width: 400px; preferred-height: 420px; min-width: 380px; min-height: 400px;
 background: #f6f7f5; default-font-family: "Microsoft YaHei UI"; default-font-size: 14px;
 in property <string> status; in property <string> detail; in property <string> action-text;
 in property <string> pack-name;
 in property <string> pack-metadata;
 in property <string> app-version;
 in property <bool> busy: false;
 in property <bool> switches-enabled: true;
 in property <bool> main-busy: false;
 in property <bool> updating: false;
 in property <bool> has-error: false;
 in property <bool> proxy-error: false;
 in property <string> settings-error;
 in property <int> progress: 0;
 in property <bool> dev-channel: false;
 callback udp-change(bool);
 callback channel-change(bool);
 in property <bool> hide-after-launch: false;
 callback hide-after-launch-change(bool);
 callback show-logs;
 callback show-licenses;
 in property <string> proxy-text; in property <string> feedback; in property <int> scenario;
 in property <bool> proxy-on: true; in property <bool> launchable: true;
 in-out property <int> page: 0;
 in-out property <bool> udp-enabled: true;
 callback primary-action; callback proxy-toggle; callback check-update;
 callback drag-window; callback close-window; callback minimize-window;
 Rectangle { background: #f6f7f5; border-radius: 8px; border-width: 1px; border-color: #dce1db;
  VerticalBox { padding: 0px; spacing: 0px;
   Rectangle { height: 48px;
    TouchArea { x: 196px; width: max(0px, parent.width - 334px); pointer-event(event) => { if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.drag-window(); } } }
    CaptionButton { y: 0px; x: parent.width - 138px; glyph: "\u{e921}"; name: "最小化"; clicked => {root.minimize-window();} }
    CaptionButton { y: 0px; x: parent.width - 92px; glyph: root.maximized ? "\u{e923}" : "\u{e922}"; name: root.maximized ? "还原" : "最大化"; clicked => {root.maximized = !root.maximized;} }
    CaptionButton { y: 0px; x: parent.width - 46px; glyph: "\u{e8bb}"; name: "关闭"; close-button: true; clicked => {root.close-window();} }
    NavItem { x: 0px; y: 0px; label: "首页"; selected: root.page == 0; clicked => {root.page = 0;} }
    NavItem { x: 64px; y: 0px; label: "设置"; selected: root.page == 1; clicked => {root.page = 1;} }
    NavItem { x: 128px; y: 0px; label: "关于"; selected: root.page == 2; clicked => {root.page = 2;} }
   }
   if root.page == 0 : VerticalBox { padding: 0px; padding-left: 32px; padding-right: 32px; padding-top: 16px; padding-bottom: 16px; spacing: 0px;
    Text { text: root.pack-name; color: #28332c; font-size: 22px; font-weight: 600; min-height: 32px; vertical-stretch: 0; wrap: word-wrap; horizontal-alignment: center; }
    Rectangle { height: 8px; }
    Text { text: root.pack-metadata; color: #6e796f; font-size: 13px; height: 24px; horizontal-alignment: center; }
    Rectangle { height: 16px; }
    Text { text: root.status; color: root.scenario == 5 ? #a16a45 : #435044; font-size: 14px; font-weight: 400; height: 24px; horizontal-alignment: center; vertical-alignment: center; }
    Rectangle { height: 8px; }
    Text { text: root.detail; overflow: elide; color: #657066; font-size: 12px; height: 20px; horizontal-alignment: center; }
    Rectangle { height: 16px; }
    Action { enabled: !root.busy; dim-disabled: root.main-busy; label: root.action-text; primary: true; height: 44px; clicked => {root.primary-action();} }
    Rectangle { height: 3px; background: root.updating ? #e0e5de : transparent; Rectangle { visible: root.updating; width: parent.width * root.progress / 100; background: #619775; } }
    Rectangle { height: 8px; }
    Rectangle { height: 32px;
     Action { enabled: !root.busy; dim-disabled: root.main-busy; x: (parent.width - 88px) / 2; y: 0px; label: "检查更新"; width: 88px; height: 32px; clicked => {root.check-update();} }
    }
    Rectangle { height: 20px;
     Text { visible: !root.has-error; text: root.feedback; color: #71816d; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
     if root.has-error : Action { x: (parent.width - 112px) / 2; width: 112px; height: 20px; label: "查看错误详情"; accessible-name: "错误详情"; text-color: #9c513b; clicked => {root.show-logs();} }
    }
    Rectangle { vertical-stretch: 1; min-height: 4px; }
    Rectangle { height: 1px; background: #e0e5de; }
    HorizontalBox { padding: 0px; spacing: 12px; height: 48px;
     Text { text: "Discord 代理"; color: #586458; vertical-alignment: center; width: 88px; font-size: 13px; }
     Rectangle { width: 40px; height: 48px;
      ToggleSwitch { enabled: root.switches-enabled; y: 8px; accessible-name: "Discord 代理开关"; checked: root.proxy-on; toggled => {root.proxy-toggle();} }
     }
     Rectangle { horizontal-stretch: 1;
      Text { visible: !root.proxy-error; text: root.proxy-text; color: #778174; vertical-alignment: center; font-size: 12px; }
      if root.proxy-error : Action { y: 8px; height: 32px; width: parent.width; label: root.proxy-on ? "已启用 · 查看原因" : "未启用 · 查看原因"; accessible-name: "代理错误详情"; text-color: #9c513b; left-aligned: true; clicked => { root.show-logs(); } }
     }
    }
    Text { text: "UPMC " + root.app-version; color: #a2aaa0; font-size: 10px; height: 16px; }
   }
   if root.page == 1 : VerticalBox { padding: 0px; padding-left: 32px; padding-right: 32px; padding-top: 16px; padding-bottom: 16px; spacing: 0px;
    HorizontalBox { padding: 0px; spacing: 24px; height: 56px;
     VerticalBox { padding: 0px; spacing: 8px;
      Text { text: "代理 UDP 流量"; color: #435044; font-size: 14px; height: 22px; }
      Text { text: "让 Discord 语音也使用代理连接"; color: #899187; font-size: 12px; height: 20px; }
     }
     Rectangle { width: 40px; height: 56px;
      ToggleSwitch { enabled: root.switches-enabled; y: 12px; accessible-name: "UDP 流量开关"; checked: root.udp-enabled; toggled => {root.udp-change(!root.udp-enabled);} }
     }
    }
    Rectangle { height: 16px; }
    HorizontalBox { padding: 0px; spacing: 24px; height: 56px;
     VerticalBox { padding: 0px; spacing: 8px;
      Text { text: "接收开发版更新"; color: #435044; font-size: 14px; height: 22px; }
      Text { text: "关闭时使用稳定版更新通道"; color: #657066; font-size: 12px; height: 20px; }
     }
     Rectangle { width: 40px; height: 56px;
      ToggleSwitch { enabled: root.switches-enabled; y: 12px; accessible-name: "开发版更新开关"; checked: root.dev-channel; toggled => {root.channel-change(!root.dev-channel);} }
     }
    }
    Rectangle { height: 16px; }
    HorizontalBox { padding: 0px; spacing: 24px; height: 56px;
     VerticalBox { padding: 0px; spacing: 8px;
      Text { text: "启动游戏后隐藏窗口"; color: #435044; font-size: 14px; height: 22px; }
      Text { text: "隐藏到系统托盘，点击图标恢复"; color: #657066; font-size: 12px; height: 20px; }
     }
     Rectangle { width: 40px; height: 56px;
      ToggleSwitch { enabled: root.switches-enabled; y: 12px; accessible-name: "启动后隐藏开关"; checked: root.hide-after-launch; toggled => {root.hide-after-launch-change(!root.hide-after-launch);} }
     }
    }
    Rectangle { vertical-stretch: 1; }
    Rectangle { height: 32px;
     if root.settings-error != "" : Action { label: "设置保存失败 · 查看原因"; accessible-name: "设置错误详情"; text-color: #9c513b; clicked => { root.show-logs(); } }
    }
    Text { text: "设置自动保存；UDP 设置在下次启用代理时生效"; wrap: word-wrap; color: #657066; font-size: 12px; min-height: 36px; }
   }
   if root.page == 2 : about-scroll := ScrollView {
    horizontal-scrollbar-policy: always-off;
    viewport-width: self.width;
    viewport-height: about-content.min-height;
    about-content := VerticalBox {
     width: about-scroll.visible-width; height: self.min-height;
     padding: 0px; padding-left: 32px; padding-right: 32px; padding-top: 16px; padding-bottom: 24px; spacing: 0px;
     Text { text: "UPMC"; color: #28332c; font-size: 22px; font-weight: 600; height: 32px; horizontal-alignment: center; }
     Text { text: "版本 " + root.app-version; color: #899187; font-size: 12px; height: 24px; horizontal-alignment: center; }
     Rectangle { height: 8px; }
     AboutSlint { height: 104px; }
     Action { label: "开源许可"; clicked => { root.show-licenses(); } }
     Rectangle { height: 16px; }
     Text { text: "主要开源项目"; color: #435044; font-size: 14px; font-weight: 600; height: 28px; }
     Text { text: "界面与窗口"; color: #435044; font-size: 13px; font-weight: 600; height: 28px; vertical-alignment: center; }
     Rectangle { height: 8px; }
     CreditItem { name: "winit 0.30.13"; detail: "窗口与输入 · Apache-2.0"; }
     CreditItem { name: "AccessKit 0.24.1"; detail: "无障碍支持 · MIT 或 Apache-2.0"; }
     CreditItem { name: "Softbuffer 0.4.8"; detail: "软件画面呈现 · MIT 或 Apache-2.0"; }
     Rectangle { height: 16px; }
     Text { text: "客户端核心"; color: #435044; font-size: 13px; font-weight: 600; height: 28px; vertical-alignment: center; }
     Rectangle { height: 8px; }
     CreditItem { name: "Xray-core"; detail: "代理服务 · MPL-2.0"; }
     CreditItem { name: "MinHook"; detail: "Windows API 挂钩 · BSD-2-Clause"; }
     CreditItem { name: "ureq 3.3.0"; detail: "HTTP 请求 · MIT 或 Apache-2.0"; }
     CreditItem { name: "Serde 1.0.228"; detail: "数据序列化 · MIT 或 Apache-2.0"; }
     Rectangle { height: 8px; }
     Text { text: "感谢开源项目及其贡献者。"; color: #899187; font-size: 12px; height: 24px; horizontal-alignment: center; }
    }
   }
  }
 }
}

export component LogWindow inherits Window {
 in property <string> heading: "错误详情";
 title: "UPMC · " + root.heading; preferred-width: 620px; preferred-height: 420px; min-width: 440px; min-height: 320px;
 in property <string> log-text;
 VerticalBox { padding: 16px; spacing: 12px;
  Text { text: root.heading + "（可选中文字并复制）"; font-size: 14px; }
  TextEdit { text: root.log-text; read-only: true; vertical-stretch: 1; min-height: 240px; }
 }
}
